# Render injects PORT automatically.
# PORT=10000

# Backend token secret
HARU_JWT_SECRET=

# Allowed frontend origins for CORS
HARU_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.example.com,https://*.vercel.app

# Database
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Lemon Squeezy
LEMON_SQUEEZY_ENABLED=false
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_SIGNING_SECRET=
LEMON_SQUEEZY_REDIRECT_URL=
LEMON_SQUEEZY_TEST_MODE=true
LEMON_SQUEEZY_CUSTOM_PRICE_EXCHANGE_RATE=1

# Jitsi JAAS
JITSI_JAAS_ENABLED=false
JITSI_JAAS_APP_ID=
JITSI_JAAS_KEY_ID=
JITSI_JAAS_PRIVATE_KEY_PEM=
JITSI_JAAS_DOMAIN=8x8.vc
JITSI_JAAS_TOKEN_TTL_MINUTES=120